rules_version = '2';

// Firebase Storage Rules for Hostel Media & Videos
service firebase.storage {
  match /b/{bucket}/o {
    match /hostel_media/{allPaths=**} {
      // Allow read access to all authenticated hostel members
      allow read: if request.auth != null;
      
      // Allow write access to authenticated users for files up to 100MB (for videos & photos)
      allow write: if request.auth != null
                   && request.resource.size < 100 * 1024 * 1024
                   && (request.resource.contentType.matches('video/.*') 
                       || request.resource.contentType.matches('image/.*'));
                       
      // Allow delete access to authenticated users
      allow delete: if request.auth != null;
    }
  }
}
